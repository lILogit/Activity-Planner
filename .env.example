# This is the safe, committed TEMPLATE — no real secrets. Copy it to the
# environment file(s) you actually use (both are gitignored, so secrets stay local):
#   cp .env.example .env.test    # Development: local uvicorn + ngrok
#   cp .env.example .env.prod    # Production:  Hostinger + Traefik
#
# How each environment loads its file:
#   Development → `KAIROS_ENV_FILE=.env.test uvicorn ...` (config.py reads it)
#   Production  → docker-compose.yml injects .env.prod via `env_file`
#
# Development: set PUBLIC_BASE_URL to your ngrok URL; DOMAIN_NAME/SSL_EMAIL are
#   unused (no Traefik). Run `ngrok http --domain=<yours> 8000`.
# Production: fill DOMAIN_NAME + SSL_EMAIL and set PUBLIC_BASE_URL to the literal
#   https://<DOMAIN_NAME> value.
#
# --- Production: Docker / Hostinger deploy (Traefik) ---
# Domain Traefik requests its Let's Encrypt cert for and routes to the app
# (docker-compose.yml's `Host(...)` rule reads this directly):
DOMAIN_NAME=srv1169048.hstgr.cloud
# Email Let's Encrypt uses for expiry/revocation notices:
SSL_EMAIL=you@example.com
# Public HTTPS URL the app registers its Telegram webhook against on startup
# (leave blank to skip). Must be a literal https://<DOMAIN_NAME> value — env_file
# values are not variable-expanded, so this can't reference ${DOMAIN_NAME} above:
PUBLIC_BASE_URL=https://srv1169048.hstgr.cloud
# In Docker, docker-compose.yml overrides this to /data/kairos.db (the mounted volume).
# For a bare-metal run, kairos.db is created next to the process:
DB_PATH=kairos.db

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6

OPENWEATHER_API_KEY=
LOCATIONIQ_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

STAYPOINT_RADIUS_M=150
STAYPOINT_MIN_DWELL_S=720
TZ=Europe/Prague

# Dashboard auth (optional). Gates ONLY the HTML pages (/dashboard, /tables);
# /api/* and /admin stay open. Leave DASHBOARD_PASSWORD empty to keep the
# dashboard open (default, keyless). SESSION_SECRET signs the session cookie —
# leave empty to auto-generate per startup (sessions won't survive a restart),
# or set a long random value (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
