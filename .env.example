# --- Docker / Hostinger deploy (docker-compose.yml uses these) ---
# Domain Caddy obtains a cert for (the Caddyfile substitutes {$DOMAIN}):
DOMAIN=kairos.example.com
# Public HTTPS URL — the app registers its Telegram webhook here on startup:
PUBLIC_BASE_URL=https://kairos.example.com
# In Docker, docker-compose.yml overrides this to /data/kairos.db (the mounted volume).
# For a bare-metal run, kairos.db is created next to the process:
DB_PATH=kairos.db

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6

OPENWEATHER_API_KEY=
LOCATIONIQ_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

STAYPOINT_RADIUS_M=150
STAYPOINT_MIN_DWELL_S=720
TZ=Europe/Prague
