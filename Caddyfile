# Caddy reverse proxy for KAIROS.
# {$DOMAIN} is substituted from the DOMAIN env var (docker compose passes it in).
# Caddy automatically: provisions a Let's Encrypt cert, redirects HTTP -> HTTPS,
# and sets X-Forwarded-For/Proto/Host on the upstream.
{$DOMAIN} {
	encode zstd gzip

	# Overland GPS batches and Telegram webhooks are small; allow headroom.
	request_body {
		max_size 10MB
	}

	reverse_proxy app:8000
}
